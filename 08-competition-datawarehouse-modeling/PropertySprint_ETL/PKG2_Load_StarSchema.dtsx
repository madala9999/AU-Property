                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT
    CAST(LTRIM(RTRIM(suburb)) AS NVARCHAR(100))     AS Suburb,
    TRY_CAST(postcode AS INT)                        AS Postcode,
    CAST(LTRIM(RTRIM(city)) AS NVARCHAR(100))        AS City,
    CAST(LTRIM(RTRIM(district)) AS NVARCHAR(100))    AS District,
    LTRIM(RTRIM([state]))     AS [State],
    LTRIM(RTRIM(state_code))  AS StateCode,
    TRY_CAST(lat AS DECIMAL(9,6)) AS Latitude,
    TRY_CAST(lon AS DECIMAL(9,6)) AS Longitude
FROM dbo.load_AusLocation
WHERE suburb IS NOT NULL AND TRY_CAST(postcode AS INT) IS NOT NULL;</property>

              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
    dl.LocationKey,
    dd.DateKey,
    dc.CategoryKey,
    TRY_CAST(REPLACE(REPLACE(LTRIM(RTRIM(pmv.Property_Median_Value)), '$', ''), ',', '') AS MONEY) AS PropertyMedianValue
FROM dbo.load_PropertyMedianValue pmv
INNER JOIN dbo.DimLocation dl
    ON LTRIM(RTRIM(pmv.Suburb)) = dl.Suburb
    AND TRY_CAST(pmv.Postcode AS INT) = dl.Postcode
INNER JOIN dbo.DimDate dd
    ON TRY_CAST(pmv.Updated_Year AS INT) = dd.[Year]
    AND TRY_CAST(pmv.Updated_Month AS INT) = dd.[Month]
INNER JOIN dbo.DimCategory dc
    ON TRY_CAST(REPLACE(REPLACE(LTRIM(RTRIM(pmv.Property_Median_Value)), '$', ''), ',', '') AS MONEY)
       BETWEEN dc.MinValue AND dc.MaxValue
WHERE pmv.Property_Median_Value IS NOT NULL;</property>

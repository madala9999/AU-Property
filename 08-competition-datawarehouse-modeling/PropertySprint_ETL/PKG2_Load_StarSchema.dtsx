              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT DISTINCT
    TRY_CAST(LTRIM(RTRIM(school_code)) AS INT)                    AS SchoolCode,
    CAST(LTRIM(RTRIM(school_name)) AS NVARCHAR(255))               AS SchoolName,
    CAST(LTRIM(RTRIM(town_suburb)) AS NVARCHAR(100))                AS Suburb,
    TRY_CAST(LTRIM(RTRIM(postcode)) AS INT)                         AS Postcode,
    CAST(LTRIM(RTRIM(level_of_schooling)) AS NVARCHAR(100))         AS LevelOfSchooling,
    CAST(LTRIM(RTRIM(selective_school)) AS NVARCHAR(100))           AS SelectiveSchool,
    CAST(LTRIM(RTRIM(opportunity_class)) AS NVARCHAR(10))           AS OpportunityClass,
    CAST(LTRIM(RTRIM(school_specialty_type)) AS NVARCHAR(100))      AS SchoolSpecialtyType,
    CAST(LTRIM(RTRIM(school_gender)) AS NVARCHAR(50))               AS SchoolGender,
    TRY_CAST(NULLIF(LTRIM(RTRIM(student_number)), 'np') AS INT)     AS StudentNumber,
    TRY_CAST(NULLIF(LTRIM(RTRIM(ICSEA_Value)), 'np') AS INT)        AS ICSEA_Value,
    TRY_CAST(latitude AS DECIMAL(9,6))                              AS Latitude,
    TRY_CAST(longitude AS DECIMAL(9,6))                             AS Longitude
FROM dbo.load_Schools
WHERE school_name IS NOT NULL;</property>

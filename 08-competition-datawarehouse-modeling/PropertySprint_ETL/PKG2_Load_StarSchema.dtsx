      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{412D78AE-708B-4849-8DD2-F5EC3B5D6467}"
          SQLTask:SqlStatementSource="-- DELETE all rows from fact tables first (because of FK constraints)&#xA;DELETE FROM dbo.FactPropertyValue;&#xA;DELETE FROM dbo.FactSchoolLocation;&#xA;&#xA;-- Then delete dimension tables&#xA;DELETE FROM dbo.DimLocation;&#xA;DELETE FROM dbo.DimDate;&#xA;DELETE FROM dbo.DimCategory;&#xA;DELETE FROM dbo.DimSchool;&#xA;&#xA;-- Reset identity counters back to 1&#xA;DBCC CHECKIDENT ('dbo.FactPropertyValue', RESEED, 0);&#xA;DBCC CHECKIDENT ('dbo.FactSchoolLocation', RESEED, 0);&#xA;DBCC CHECKIDENT ('dbo.DimLocation', RESEED, 0);&#xA;DBCC CHECKIDENT ('dbo.DimCategory', RESEED, 0);&#xA;DBCC CHECKIDENT ('dbo.DimSchool', RESEED, 0);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>

          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{AB994005-88D4-421A-AB2A-8941A757DBB6}"
              SQLTask:SqlStatementSource="INSERT INTO star.DimSchool (SchoolCode, StateCode, SchoolName, SchoolType, Address, Postcode)&#xA;SELECT SchoolCode, StateCode, SchoolName, SchoolType, Address, Postcode&#xA;FROM (&#xA;    SELECT SchoolCode, StateCode, SchoolName, SchoolType, Address, Postcode,&#xA;           ROW_NUMBER() OVER (PARTITION BY SchoolCode, StateCode ORDER BY SchoolCode) AS rn&#xA;    FROM dw.School&#xA;) d&#xA;WHERE rn = 1;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />

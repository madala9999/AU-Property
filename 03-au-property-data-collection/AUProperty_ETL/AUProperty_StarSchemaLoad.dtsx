          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{AB994005-88D4-421A-AB2A-8941A757DBB6}"
              SQLTask:SqlStatementSource="INSERT INTO star.DimOffenceType (OffenceCategory, OffenceSubcategory)&#xA;   SELECT DISTINCT UPPER(LTRIM(RTRIM(OffenceCategory))), UPPER(LTRIM(RTRIM(OffenceSubcategory)))&#xA;   FROM dw.Crime;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>

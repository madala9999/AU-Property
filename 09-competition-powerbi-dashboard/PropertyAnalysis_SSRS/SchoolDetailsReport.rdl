  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DS_PropertyAnalysisDW">
      <DataSourceReference>DS_PropertyAnalysisDW</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>5c56e4ef-4cf9-4f4d-b80b-b5df1a73fce9</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="dsSchoolData">
      <Query>
        <DataSourceName>DS_PropertyAnalysisDW</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Suburb">
            <Value>=Parameters!Suburb.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Postcode">
            <Value>=Parameters!Postcode.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT
    COALESCE(L.City,'Unknown') AS [City/Town],
    S.Suburb,
    S.Postcode,
    S.SchoolName          AS [School Name],
    S.SchoolSpecialtyType AS [School Type],
    S.LevelOfSchooling    AS [School SubType],
    S.ICSEA_Value         AS [ICSEA Value],
    S.StudentNumber       AS [Students],
    S.SchoolGender        AS [Gender],
    S.SelectiveSchool     AS [Selective],
    PV.AvgValue           AS [Avg Property Value]
FROM dbo.DimSchool S
LEFT JOIN dbo.DimLocation L
       ON S.Suburb = L.Suburb AND S.Postcode = L.Postcode
LEFT JOIN (SELECT LocationKey,
                  AVG(PropertyMedianValue) AS AvgValue
           FROM dbo.FactPropertyValue
           GROUP BY LocationKey) PV
       ON PV.LocationKey = L.LocationKey
WHERE S.Suburb   IN (@Suburb)
  AND S.Postcode IN (@Postcode)
ORDER BY [City/Town], S.Suburb, S.SchoolName;</CommandText>
      </Query>
      <Fields>
        <Field Name="City_Town">
          <DataField>City/Town</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Suburb">
          <DataField>Suburb</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Postcode">
          <DataField>Postcode</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="School_Name">
          <DataField>School Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="School_Type">
          <DataField>School Type</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="School_SubType">
          <DataField>School SubType</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ICSEA_Value">
          <DataField>ICSEA Value</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Students">
          <DataField>Students</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Avg_Property_Value">
          <DataField>Avg Property Value</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Gender">
          <DataField>Gender</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Selective">
          <DataField>Selective</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsSuburbList">
      <Query>
        <DataSourceName>DS_PropertyAnalysisDW</DataSourceName>
        <CommandText>SELECT DISTINCT Suburb FROM dbo.DimSchool ORDER BY Suburb;</CommandText>
      </Query>
      <Fields>
        <Field Name="Suburb">
          <DataField>Suburb</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
